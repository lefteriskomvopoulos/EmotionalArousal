# Branch `deconvolution`.  Allow-list: only what is named here is shared.  Everything else stays local.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/requirements.txt
!/REPRODUCE.md
!/reproduce.sh
!/reproduce/

# The IEEE report (LaTeX for Overleaf): text, references, figures
!/report/
/report/*.aux
/report/*.log
/report/*.bbl
/report/*.blg
/report/*.out
/report/*.synctex.gz
/report/slides/equations/*.aux
/report/slides/equations/*.log

# Code
!/src/
/src/tools/
/src/tbme/
/src/eda/archive/
__pycache__/
*.pyc

# Docs: the experiment log and the metadata workbook the quality screen reads
!/docs/
/docs/*
!/docs/EXPERIMENTS.md
!/docs/dataset_check/

# Result tables, and the synthetic truth needed to re-score (our input variants only)
!/data/
/data/*
!/data/*.csv
!/data/tbme_synth/
/data/tbme_synth/*
!/data/tbme_synth/*_own.npz
!/data/tbme_synth/*_own4.npz

# Our figures
!/results/
/results/*
!/results/figures/
/results/figures/*
!/results/figures/stages_*.png
!/results/figures/raw_atlas_*.png
!/results/figures/filter_response.png
!/results/figures/*_deconv.pdf
!/results/figures/stage2_*.png
!/results/figures/stage2_*.pdf
!/results/figures/round*_tonic.pdf
!/results/figures/tune50_vs_real.pdf
!/results/figures/tune50_preview_vs_real.pdf
!/results/figures/tune50_preview/
/results/figures/tune50_preview/*
!/results/figures/tune50_preview/INSPECTION.md

# Cluster output: csv and logs.  The .mat files repeat the csv and nothing reads them.
!/hpc/
/hpc/*
!/hpc/own/
/hpc/**/*.mat
/hpc/**/*.zip
/hpc/**/*.tar.gz
# Per-sample signals (*_signals.csv, 260 MB in all) only where they are needed from the repository:
# the final run's 50 real participants (stage 2, figures) and its 50 test sessions, and the
# re-synthesis (re-scoring the reported accuracy needs them).  Every other run keeps its events,
# windows and logs; its signals come back by re-running its bundle.  Rounds 1-4's signals were
# committed before this rule and stay.
/hpc/**/*_signals.csv
!/hpc/own/final/output/own4_p1000_k14_f3_s8/P*_signals.csv
!/hpc/own/final/output/own4_p1000_k14_f3_s8/V*_signals.csv
!/hpc/own/resynth/output/own4_p1000_k14_f3_s8/R*_signals.csv
# Round 8's settings on the 18 tuning sessions: round-compare reads their tonic (REPRODUCE.md)
!/hpc/own/tune/output/own4_p1000_k14_f3_s8/U*_signals.csv
!/hpc/own/tune/output/own4_p1000_k20_f3_s8/U*_signals.csv
!/hpc/own/tune/output/own4_p1000_k28_f3_s8/U*_signals.csv
# The other 47 (extra-export): stage 2 reads their signals as it does the 50's
!/hpc/own/extra/output/own4_p1000_k14_f3_s8/P*_signals.csv

.DS_Store

# written by reproduce.sh
/reproduce_report.csv
